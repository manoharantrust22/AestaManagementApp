# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (required for admin operations like creating users)
# Server-only. Never prefix with NEXT_PUBLIC_ (that ships it to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Feature flags
# Redesigned All Site Expenses page (Labor / Building groups, single scrollbar,
# sticky filter bar). Off by default. Set to "true" to enable.
NEXT_PUBLIC_FF_EXPENSES_REDESIGN=false

# Dev/testing only — enables /dev-login auto-auth page for Playwright.
# Set to "true" locally. Leave unset in Vercel production.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=true

# --- AI assistant + voice (server-only) ---
# Google AI Studio key. Powers /api/assistant (Tamil/English voice agent) and /api/transcribe.
GEMINI_API_KEY=
# Optional model override (default: gemini-3.8-flash)
GEMINI_MODEL=

# --- Web push (task alerts on phones) ---
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Shared secret the DB trigger sends to /api/push/dispatch. Must equal the Vault
# secret 'push_dispatch_secret' (see 20261108100100_web_push.sql).
PUSH_DISPATCH_SECRET=

# --- Bug reports ---
# Who receives bug reports from non-admins (default: first admin user)
NEXT_PUBLIC_BUG_REPORT_ASSIGNEE_EMAIL=
